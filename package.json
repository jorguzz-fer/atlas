{
  "name": "atlas-corpo-humano",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3016",
    "build": "vite build && npm run build:server",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "validate:atlas": "node scripts/validate-atlas.mjs",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist-server/index.js --banner:js=\"import {createRequire} from 'node:module';const require=createRequire(import.meta.url);\"",
    "start": "node dist-server/index.js",
    "names:build": "node scripts/names/build.mjs",
    "names:ai": "node scripts/names/fill-with-ai.mjs",
    "dev:server": "DIST_DIR=public tsx watch server/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@base-ui/react": "1.7.0",
    "@hono/node-server": "^2.1.6",
    "@shadcn/react": "0.3.0",
    "@types/three": "^0.159.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "hono": "^4.13.16",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.159.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "^0.28.2",
    "meshoptimizer": "^1.2.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}